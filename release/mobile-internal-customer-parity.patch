+type MobileAssignment struct {
+	CustomerID   uint64   `json:"customerId"`
+	CustomerName string   `json:"customerName"`
+	GSTNo        string   `json:"gstNo"`
+	Permissions  []string `json:"permissions" gorm:"-"`
+	Owner        bool     `json:"owner" gorm:"-"`
+}
+
+// Internal customer access always follows the existing Person for Customer
+// mappings. Read them on each request so removal never leaves stale access.
+func MobileInternalCustomers(db *gorm.DB, account models.MobileAccount) ([]MobileAssignment, error) {
+	assignments := []MobileAssignment{}
+	if account.Kind != "INTERNAL" || !account.Active || account.Invited {
+		return assignments, nil
+	}
+	err := db.Table("customers c").Distinct("c.id AS customer_id, c.CustomerName AS customer_name, c.GstNo AS gst_no").
+		Joins("JOIN person_customers pc ON pc.cust_id=c.id AND pc.is_active=1 AND pc.deleted_at IS NULL").
+		Joins("JOIN people p ON p.id=pc.person_id AND p.deleted_at IS NULL AND p.status='ACTIVE'").
+		Where("p.user_id = ? AND c.deleted_at IS NULL AND c.IsHidden=0 AND c.IsRegistrationOnly=0", account.UserID).
+		Order("c.CustomerName, c.id").Scan(&assignments).Error
+	if err != nil {
+		return nil, err
+	}
+	permissions := MobileAccountTasks(account)
+	if permissions == nil {
+		permissions = []string{"catalog"}
+	}
+	for i := range assignments {
+		assignments[i].Permissions = append([]string{}, permissions...)
+	}
+	return assignments, nil
+}
